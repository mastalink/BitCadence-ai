{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "capabilities": {
      "maxProperties": 64,
      "patternProperties": {
        "^[a-z][a-z0-9-]{0,63}$": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            }
          ]
        }
      },
      "title": "Capabilities",
      "type": "object"
    },
    "endpoint": {
      "maxLength": 1024,
      "title": "Endpoint",
      "type": "string"
    },
    "health": {
      "default": "unknown",
      "enum": [
        "ok",
        "degraded",
        "offline",
        "unknown"
      ],
      "title": "Health",
      "type": "string"
    },
    "id": {
      "pattern": "^[a-z][a-z0-9-]{0,63}$",
      "title": "Id",
      "type": "string"
    },
    "schema": {
      "const": "bitcadence.node/1",
      "title": "Schema",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "id",
    "endpoint"
  ],
  "title": "Node",
  "type": "object"
}

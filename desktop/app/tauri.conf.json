{
  "productName": "BitCadence Desktop",
  "version": "0.1.0",
  "identifier": "org.bitcadence.desktop",
  "build": {
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BitCadence Desktop",
        "width": 800,
        "height": 520,
        "minWidth": 360,
        "minHeight": 300
      }
    ],
    "security": {
      "capabilities": ["desktop-main"],
      "pattern": { "use": "isolation", "options": { "dir": "isolation" } },
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost; base-uri 'none'; form-action 'none'; object-src 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
